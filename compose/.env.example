# Copy to .env (scripts/gen-env.ps1 does this and fills secrets). Never commit .env.

# Open WebUI backend URL. Stage 1: llama-server directly on the host.
# Stage 3: switch to http://litellm:4000/v1 (and set OPENAI_API_KEY to LITELLM_MASTER_KEY or a LiteLLM virtual key).
OPENAI_API_BASE_URL=http://host.docker.internal:8080/v1
# API key Open WebUI sends to the backend (stage 1: same as LLAMA_API_KEY).
OPENAI_API_KEY=change-me
# API key llama-server was started with (used by LiteLLM and Prometheus).
LLAMA_API_KEY=change-me
# Open WebUI session signing secret.
WEBUI_SECRET_KEY=change-me
# Allow account creation in Open WebUI; set false after creating the admin account.
ENABLE_SIGNUP=true

# Postgres database name for LiteLLM.
POSTGRES_DB=litellm
# Postgres user.
POSTGRES_USER=litellm
# Postgres password (hex only, so it is safe inside DATABASE_URL).
POSTGRES_PASSWORD=change-me

# LiteLLM master/admin key (must start with sk-).
LITELLM_MASTER_KEY=sk-change-me
# LiteLLM salt key encrypting stored credentials; never change after first start.
LITELLM_SALT_KEY=change-me

# Grafana admin username.
GRAFANA_ADMIN_USER=admin
# Grafana admin password.
GRAFANA_ADMIN_PASSWORD=change-me

# Secret key for the SearXNG web search container
SEARXNG_SECRET=change-me

# API key for the agent sandbox (Open Terminal)
OPEN_TERMINAL_API_KEY=change-me
# Host folder the agent sandbox may read and write (the only host path it sees)
AGENT_WORKSPACE=C:/path/to/agent-workspace

# Google Calendar tool. Filled in by: python scripts/google-auth.py <client_secret.json>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Phone pushes (ntfy) and the briefing job. scripts/gen-env.ps1 fills the secrets.
# Public address of the chat UI (tapping a notification opens it); from `tailscale serve status`.
ULTRON_PUBLIC_URL=https://<pc-name>.<tailnet>.ts.net
# Address the phone uses for ntfy (same host, second HTTPS port).
NTFY_BASE_URL=https://<pc-name>.<tailnet>.ts.net:8443
# Password of the ntfy user "ultron" (hex).
NTFY_PASSWORD=change-me
# ntfy access token (tk_ plus 29 lowercase letters and digits).
NTFY_TOKEN=tk_change-me
# One private topic for the briefings (random, e.g. ultron-1a2b3c4d5e6f7a8b).
NTFY_TOPIC=ultron-change-me
# Bearer key for the spoken-briefing clip (random; gen-env.ps1 fills it).
VOICE_KEY=change-me
# Bearer key for the paper-digest link queue (Open WebUI tool paper_reader -> http://paper-digest:8095/queue). Random hex; gen-env.ps1 can fill it.
PAPER_QUEUE_KEY=change-me
