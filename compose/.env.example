# Ultron settings and secrets. Copy to .env (scripts\gen-env.ps1 does this and fills the secrets).
# Never commit .env. To put an existing .env into this order and layout: python scripts\tidy-env.py
# After changing a value: docker compose -p ultron up -d   (recreates what uses it)

# ============================================================ Local model and gateway
# Where chat, briefings and the paper digest send model calls: the LiteLLM gateway.
# (Stage 1 without the gateway: http://host.docker.internal:8080/v1, the model server directly.)
OPENAI_API_BASE_URL=http://host.docker.internal:8080/v1
# Key for that gateway (a LiteLLM key, or LLAMA_API_KEY in stage 1). Not an OpenAI key: Open WebUI needs this name.
OPENAI_API_KEY=change-me
# Key the local model server (llama-server) was started with; used by LiteLLM and Prometheus.
LLAMA_API_KEY=change-me
# LiteLLM admin key (must start with sk-).
LITELLM_MASTER_KEY=sk-change-me
# LiteLLM salt key encrypting stored credentials; never change after first start.
LITELLM_SALT_KEY=change-me
# LiteLLM's database (Postgres). Password: hex only, so it is safe inside DATABASE_URL.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me

# ============================================================ Cloud models (optional)
# Fill only the providers you use; an empty key means that provider is off. After a change:
#   docker compose -p ultron up -d litellm paper-digest
# Order to try them when the paper digest's config says "cloud" (first one that works wins, then local).
CLOUD_PRIORITY=gemini,claude,gpt

# OpenAI (model cloud-gpt). Its own name: OPENAI_API_KEY above is the gateway key.
OPENAI_CLOUD_API_KEY=
OPENAI_CLOUD_MODEL=gpt-6-luna

# Anthropic (model cloud-claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini (model cloud-gemini). Free key: Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ============================================================ Open WebUI (chat)
# Session signing secret.
WEBUI_SECRET_KEY=change-me
# Allow account creation; set false after creating the admin account.
ENABLE_SIGNUP=true
# Public address of the chat UI (tapping a notification opens it); from `tailscale serve status`.
ULTRON_PUBLIC_URL=https://<pc-name>.<tailnet>.ts.net
# Open WebUI API key (Settings > Account > API Keys): lets the briefings and the paper digest save chats.
ULTRON_API_KEY=

# ============================================================ Google (Calendar, Tasks, Gmail, Drive)
# Filled in by: python scripts\google-auth.py <client_secret.json>   (later: --from-env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Bearer key Open WebUI uses for the calendar MCP server (http://calendar-mcp:8000/mcp).
CALENDAR_MCP_API_KEY=change-me

# ============================================================ Phone pushes and briefings
# Address the phone uses for ntfy (same host as the chat UI, second HTTPS port).
NTFY_BASE_URL=https://<pc-name>.<tailnet>.ts.net:8443
# Password of the ntfy user "ultron" (hex).
NTFY_PASSWORD=change-me
# ntfy access token (tk_ plus 29 lowercase letters and digits).
NTFY_TOKEN=tk_change-me
# One private topic for all pushes (random, e.g. ultron-1a2b3c4d5e6f7a8b).
NTFY_TOPIC=ultron-change-me
# Bearer key for the spoken evening briefing clip.
VOICE_KEY=change-me

# ============================================================ Paper digest
# Bearer key for the link queue (Open WebUI tool paper_reader -> http://paper-digest:8095/queue).
PAPER_QUEUE_KEY=change-me

# ============================================================ Agent sandbox and web search
# API key for the agent sandbox (Open Terminal).
OPEN_TERMINAL_API_KEY=change-me
# Host folder the agent sandbox may read and write (the only host path it sees).
AGENT_WORKSPACE=C:/path/to/agent-workspace
# Secret key for the SearXNG web search container.
SEARXNG_SECRET=change-me

# ============================================================ Monitoring (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
