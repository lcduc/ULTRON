{
  "description": "Animate one still image into a short video (Wan 2.2 14B image-to-video, Q4 GGUF, 4-step Lightning). Saves an mp4 at 16 fps. Slow: several minutes per clip.",
  "timeout_seconds": 2400,
  "params": {
    "image": {"node": "9", "input": "image", "type": "image", "required": true, "help": "Start frame: path of an image in the workspace, e.g. outputs/file.png"},
    "prompt": {"node": "11", "input": "text", "type": "str", "required": true, "help": "What moves and how: subject action, camera move, light. Describe motion, not the picture."},
    "negative_prompt": {"node": "12", "input": "text", "type": "str", "help": "Things to avoid. A sensible default is built in."},
    "seed": {"node": "14", "input": "noise_seed", "type": "seed", "help": "Random if omitted"},
    "width": {"node": "13", "input": "width", "type": "int", "min": 320, "max": 832, "help": "Multiple of 16. Default 480. Use 832 with height 480 for landscape."},
    "height": {"node": "13", "input": "height", "type": "int", "min": 320, "max": 832, "help": "Multiple of 16. Default 832. Use 480 with width 832 for landscape."},
    "length": {"node": "13", "input": "length", "type": "int", "min": 17, "max": 81, "help": "Frames, must be 4n+1 (17, 33, 49, 65, 81). 16 fps, so 49 is about 3 s and 81 about 5 s. Default 81, the standard for finished shots."}
  },
  "graph": {
    "1": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "Wan2.2-I2V-A14B-HighNoise-Q4_K_S.gguf"}},
    "2": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "Wan2.2-I2V-A14B-LowNoise-Q4_K_S.gguf"}},
    "3": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors", "strength_model": 1.0}},
    "4": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["2", 0], "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors", "strength_model": 1.0}},
    "5": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["3", 0], "shift": 5.0}},
    "6": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["4", 0], "shift": 5.0}},
    "7": {"class_type": "CLIPLoader", "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}},
    "8": {"class_type": "VAELoader", "inputs": {"vae_name": "wan_2.1_vae.safetensors"}},
    "9": {"class_type": "LoadImage", "inputs": {"image": ""}},
    "11": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["7", 0], "text": ""}},
    "12": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["7", 0], "text": "blurry, low quality, worst quality, jpeg artifacts, distorted face, deformed hands, extra fingers, static, frozen, subtitles, watermark, text"}},
    "13": {"class_type": "WanImageToVideo", "inputs": {"positive": ["11", 0], "negative": ["12", 0], "vae": ["8", 0], "width": 480, "height": 832, "length": 81, "batch_size": 1, "start_image": ["9", 0]}},
    "14": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["5", 0], "add_noise": "enable", "noise_seed": 42, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["13", 0], "negative": ["13", 1], "latent_image": ["13", 2], "start_at_step": 0, "end_at_step": 2, "return_with_leftover_noise": "enable"}},
    "15": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["6", 0], "add_noise": "disable", "noise_seed": 0, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["13", 0], "negative": ["13", 1], "latent_image": ["14", 0], "start_at_step": 2, "end_at_step": 10000, "return_with_leftover_noise": "disable"}},
    "16": {"class_type": "VAEDecode", "inputs": {"samples": ["15", 0], "vae": ["8", 0]}},
    "17": {"class_type": "CreateVideo", "inputs": {"images": ["16", 0], "fps": 16.0}},
    "18": {"class_type": "SaveVideo", "inputs": {"video": ["17", 0], "filename_prefix": "ultron_wan22_i2v", "format": "auto", "codec": "auto"}}
  }
}
