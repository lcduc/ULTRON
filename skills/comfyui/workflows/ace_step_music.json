{
  "description": "Generate music or an instrumental underscore from text tags (ACE-Step 1.5 turbo, 8 steps). Saves an mp3. Instrumental by default; pass lyrics with [Verse]/[Chorus] sections for a sung track.",
  "timeout_seconds": 900,
  "params": {
    "tags": {"node": "94", "input": "tags", "type": "str", "required": true, "help": "Style description: genre, instruments, mood, tempo, e.g. 'warm playful acoustic guitar, light percussion, cheerful, instrumental'."},
    "lyrics": {"node": "94", "input": "lyrics", "type": "str", "help": "Default [inst] = instrumental. Otherwise lyrics with section markers like [Verse] and [Chorus]."},
    "duration": {"node": "99", "input": "value", "type": "int", "min": 10, "max": 120, "help": "Length in seconds. Default 30."},
    "seed": {"node": "102", "input": "value", "type": "seed", "help": "Random if omitted"},
    "bpm": {"node": "94", "input": "bpm", "type": "int", "min": 40, "max": 220, "help": "Tempo. Default 120."},
    "keyscale": {"node": "94", "input": "keyscale", "type": "str", "choices": ["C major", "C# major", "Db major", "D major", "D# major", "Eb major", "E major", "F major", "F# major", "Gb major", "G major", "G# major", "Ab major", "A major", "A# major", "Bb major", "B major", "C minor", "C# minor", "Db minor", "D minor", "D# minor", "Eb minor", "E minor", "F minor", "F# minor", "Gb minor", "G minor", "G# minor", "Ab minor", "A minor", "A# minor", "Bb minor", "B minor"], "help": "Musical key. Default C major."}
  },
  "graph": {
    "97": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "ace_step_1.5_turbo_aio.safetensors"}},
    "99": {"class_type": "PrimitiveFloat", "inputs": {"value": 30}},
    "102": {"class_type": "PrimitiveInt", "inputs": {"value": 31}},
    "94": {"class_type": "TextEncodeAceStepAudio1.5", "inputs": {"clip": ["97", 1], "tags": "", "lyrics": "[inst]", "seed": ["102", 0], "bpm": 120, "duration": ["99", 0], "timesignature": "4", "language": "en", "keyscale": "C major", "generate_audio_codes": true, "cfg_scale": 2.0, "temperature": 0.85, "top_p": 0.9, "top_k": 0, "min_p": 0.0}},
    "47": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["94", 0]}},
    "78": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["97", 0], "shift": 3.0}},
    "98": {"class_type": "EmptyAceStep1.5LatentAudio", "inputs": {"seconds": ["99", 0], "batch_size": 1}},
    "3": {"class_type": "KSampler", "inputs": {"model": ["78", 0], "seed": ["102", 0], "steps": 8, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["94", 0], "negative": ["47", 0], "latent_image": ["98", 0], "denoise": 1.0}},
    "18": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["3", 0], "vae": ["97", 2]}},
    "106": {"class_type": "SaveAudioMP3", "inputs": {"audio": ["18", 0], "filename_prefix": "audio/ultron_music", "quality": "V0"}}
  }
}
