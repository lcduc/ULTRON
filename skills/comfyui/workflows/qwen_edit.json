{
  "description": "Edit an existing image from a text instruction (Qwen Image Edit, 4-step Lightning).",
  "timeout_seconds": 900,
  "params": {
    "image": {"node": "7", "input": "image", "type": "image", "required": true, "help": "Path of an image in the workspace, e.g. outputs/file.png"},
    "prompt": {"node": "10", "input": "prompt", "type": "str", "required": true, "help": "The change to make, and what to keep the same"},
    "seed": {"node": "13", "input": "seed", "type": "seed", "help": "Random if omitted"},
    "megapixels": {"node": "9", "input": "megapixels", "type": "float", "min": 0.5, "max": 1.5}
  },
  "graph": {
    "1": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "qwen-image-edit-2511-Q4_K_S.gguf"}},
    "2": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0}},
    "3": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["2", 0], "shift": 3.0}},
    "4": {"class_type": "CFGNorm", "inputs": {"model": ["3", 0], "strength": 1.0}},
    "5": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"}},
    "6": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
    "7": {"class_type": "LoadImage", "inputs": {"image": ""}},
    "9": {"class_type": "ImageScaleToTotalPixels", "inputs": {"image": ["7", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16}},
    "10": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["5", 0], "prompt": "", "vae": ["6", 0], "image1": ["9", 0]}},
    "11": {"class_type": "TextEncodeQwenImageEditPlus", "inputs": {"clip": ["5", 0], "prompt": "", "vae": ["6", 0], "image1": ["9", 0]}},
    "12": {"class_type": "VAEEncode", "inputs": {"pixels": ["9", 0], "vae": ["6", 0]}},
    "13": {"class_type": "KSampler", "inputs": {"model": ["4", 0], "seed": 42, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["10", 0], "negative": ["11", 0], "latent_image": ["12", 0], "denoise": 1.0}},
    "14": {"class_type": "VAEDecode", "inputs": {"samples": ["13", 0], "vae": ["6", 0]}},
    "15": {"class_type": "SaveImage", "inputs": {"images": ["14", 0], "filename_prefix": "ultron_qwen_edit"}}
  }
}
