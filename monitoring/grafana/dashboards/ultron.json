                                       {
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "prometheus"
                                                          },
                                           "legendFormat":  "prompt",
                                           "expr":  "sum(rate(litellm_llm_api_time_to_first_token_metric_sum[5m])) / sum(rate(litellm_llm_api_time_to_first_token_metric_count[5m]))",
                                           "refId":  "A"
                                       }
                                   ]
                   },
