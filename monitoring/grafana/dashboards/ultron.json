{
    "uid":  "ultron-main",
    "title":  "Ultron",
    "tags":  [
                 "ultron"
             ],
    "schemaVersion":  39,
    "version":  1,
    "timezone":  "browser",
    "refresh":  "30s",
    "time":  {
                 "to":  "now",
                 "from":  "now-6h"
             },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Generation tokens/s",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "y":  0,
                                       "w":  12,
                                       "h":  8,
                                       "x":  0
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "none"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "datasource":  {
                                                              "type":  "prometheus",
                                                              "uid":  "prometheus"
                                                          },
                                           "legendFormat":  "generation",
                                           "expr":  "1 / (sum(rate(litellm_deployment_latency_per_output_token_sum[5m])) / sum(rate(litellm_deployment_latency_per_output_token_count[5m])))",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "Time to first token (s)",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "gridPos":  {
                                       "y":  0,
                                       "w":  12,
                                       "h":  8,
                                       "x":  12
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
